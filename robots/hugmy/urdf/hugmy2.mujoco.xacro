<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hugmy2">
  <!-- The pneumatic MuJoCo hardware simulation applies pressure-dependent torques to these articulated arm joints. -->
  <xacro:arg name="fixed_arms" default="false" />
  <xacro:arg name="body_mesh" default="package://hugmy/urdf/mesh/body_with_face_mujoco.stl" />
  <xacro:include filename="$(find hugmy)/urdf/hugmy2.urdf.xacro" />
</robot>
