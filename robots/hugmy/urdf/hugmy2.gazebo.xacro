<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hugmy2">
  <xacro:arg name="robot_name" default="quadrotor" />

  <!-- The caller supplies fixed_arms:=true.  The base file keeps the normal
       articulated model as its default for RViz and other uses. -->
  <xacro:include filename="$(find hugmy)/urdf/hugmy2.urdf.xacro" />

  <!-- Standard Gazebo Spinal simulation: flight controller, IMU and four
       rotor thrust interfaces.  No pneumatic plugin is installed here. -->
  <xacro:include filename="$(find aerial_robot_simulation)/xacro/spinal.gazebo.xacro" />
  <xacro:gazebo_spinal robot_name="$(arg robot_name)" />

  <gazebo reference="main_body">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
</robot>
