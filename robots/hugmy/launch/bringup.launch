<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="rm" default="True" />
  <arg name="sim" default="False" />
  <arg name="real_machine" default="$(arg rm)" />
  <arg name="simulation" default="$(arg sim)" />
  <arg name="mujoco" default="False" />
  <arg name="estimate_mode"  default= "0" />
  <arg name="sim_estimate_mode"  default= "2" />
  <arg name="headless" default="True" />
  <arg name="spawn_human" default="False"/>
  <arg name="human_arm_center_z" default="0.05"/>
  <!-- MuJoCo-only common vertical offset for robot and grasp cylinder. -->
  <arg name="mujoco_initial_height_offset" default="0.10"/>
  <arg name="start_pressure_controller" default="False"/>
  <arg name="start_attitude_allocator" default="False"/>
  <arg name="quad_bi_controller" default="False"/>
  <arg name="inchworm_action_c" default="False"/>
  <arg name="hybrid_locomotion_outer_enabled" default="true"/>
  <arg name="hybrid_locomotion_initial_bottom_kpa" default="30.0"/>
  <arg name="hybrid_rear_release_sec" default="2.0"/>
  <arg name="hybrid_rear_grasp_sec" default="1.0"/>
  <arg name="hybrid_rear_low_kpa" default="0.0"/>
  <arg name="hybrid_rear_vent_lead_margin_sec" default="0.10"/>
  <arg name="hybrid_rear_vent_start_margin_rad" default="0.13962634015954636"/>
  <arg name="hybrid_locomotion_initial_m" default="1.0"/>
  <arg name="hybrid_locomotion_retain_grasp_pressure" default="false"/>
  <arg name="hybrid_locomotion_regrip_timeout_sec" default="20.0"/>
  <arg name="hybrid_lift_pressure_gain_kpa_s_rad" default="20.0"/>
  <arg name="hybrid_slip_min_progress_m" default="0.002"/>
  <arg name="hybrid_slip_min_speed_m_s" default="0.0015"/>
  <arg name="hybrid_lift_probe_sec" default="15.0"/>
  <arg name="hybrid_lift_search_rate_n_s" default="0.7"/>
  <arg name="hybrid_reused_lift_rise_n_s" default="8.0"/>
  <arg name="hybrid_trajectory_min_extension_rad" default="0.2617993877991494"/>
  <arg name="hybrid_trajectory_extension_rate_rad_s" default="0.70"/>
  <arg name="hybrid_lift_rear_release_start_ratio" default="0.10"/>
  <arg name="hybrid_lift_rear_pressure_floor_kpa" default="0.0"/>
  <arg name="hybrid_regrip_rear_hold_pressure_kpa" default="10.0"/>
  <arg name="hybrid_pull_rear_release_start_ratio" default="0.05"/>
  <arg name="hybrid_pull_rear_release_end_ratio" default="0.65"/>
  <arg name="hybrid_trajectory_golden_handoff_enabled" default="true"/>
  <arg name="hybrid_trajectory_windup_pitch_rad" default="0.29670597283903605"/>
  <arg name="hybrid_trajectory_windup_pitch_kp_n_rad" default="3.0"/>
  <arg name="hybrid_trajectory_windup_pitch_kd_n_s_rad" default="1.0"/>
  <arg name="hybrid_trajectory_windup_pitch_rate_max_rad_s" default="0.25"/>
  <arg name="hybrid_trajectory_windup_bottom_kpa" default="30.0"/>
  <arg name="hybrid_trajectory_windup_extra_extension_rad" default="1.0471975511965976"/>
  <arg name="hybrid_trajectory_windup_hold_pressure_kpa" default="30.0"/>
  <arg name="hybrid_trajectory_windup_pressure_slew_kpa_s" default="12.0"/>
  <arg name="hybrid_trajectory_windup_rear_reverse_max_n" default="1.5"/>
  <arg name="hybrid_trajectory_windup_rear_reverse_rise_n_s" default="0.75"/>
  <arg name="hybrid_locomotion_pitch_change_limit_rad" default="0.3490658503988659"/>
  <arg name="hybrid_trajectory_flex_rate_rad_s" default="1.2"/>
  <arg name="hybrid_trajectory_pressure_lead_max_sec" default="0.60"/>
  <arg name="hybrid_reused_lift_brake_margin_rad" default="0.06981317007977318"/>
  <arg name="hybrid_pull_min_sec" default="0.5"/>
  <arg name="hybrid_probe_extension_rad" default="0.13962634015954636"/>
  <arg name="hybrid_lift_identification_bend_rad" default="0.7853981633974483"/>
  <arg name="hybrid_lift_identification_tolerance_rad" default="0.03490658503988659"/>
  <arg name="hybrid_lift_identification_extension_limit_rad" default="1.7278759594743862"/>
  <arg name="hybrid_lift_identification_rate_feedback_min_bend_rad" default="0.7853981633974483"/>
  <arg name="hybrid_lift_identification_rate_filter_tau_sec" default="0.25"/>
  <arg name="hybrid_lift_identification_rate_confirm_sec" default="0.15"/>
  <arg name="hybrid_lift_unload_min_extension_rad" default="0.05235987755982989"/>
  <arg name="hybrid_lift_unload_pitch_rad" default="0.06981317007977318"/>
  <arg name="hybrid_lift_unload_height_m" default="0.003"/>
  <!-- A +x front-pair lift decreases measured pitch in both current Spinal
       hardware and MuJoCo; normalize it to positive load-relief pitch. -->
  <arg name="hybrid_directional_pitch_sign" default="-1.0"/>
  <arg name="hybrid_lift_unload_confirm_sec" default="0.12"/>
  <arg name="hybrid_lift_unload_prefill_start_ratio" default="0.70"/>
  <arg name="hybrid_lift_unload_prefill_kpa" default="3.0"/>
  <arg name="hybrid_lift_unload_prefill_max_prediction_sec" default="0.60"/>
  <arg name="hybrid_lift_unload_prefill_max_prediction_lead_ratio" default="0.15"/>
  <arg name="hybrid_slip_probe_max_thrust_n" default="5.0"/>
  <arg name="hybrid_slip_probe_max_pressure_kpa" default="40.0"/>
  <!-- Arm pressure may reach 40 kPa during the horizontal slip test.  The
       bottom inflatable has its own independent 30-kPa limit. -->
  <arg name="maximum_pressure_kpa" default="40.0"/>
  <arg name="recovery_predictive_enabled" default="true"/>
  <arg name="recovery_predictive_shadow" default="true"/>
  <!-- Hardware follows the Spinal sign convention.  Keep the independently
       verified MuJoCo force/contact convention simulation-only; recovery must
       be triggered before large roll momentum makes either pair appear
       ineffective. -->
  <arg name="correction_pair_reverse_spinal_mapping" default="$(arg mujoco)"/>
  <arg name="hybrid_reverse_geometry_roll_moment" default="$(arg mujoco)"/>
  <arg name="inchworm_action_d" default="False"/>
  <arg name="enable_pneumatic_plugin" default="True"/>
  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty.world"/>
  <arg name="launch_gazebo" default="True" />
  <arg name="direct_model" default="False" />
  <arg name="direct_model_name" />
  <arg name="robot_model_name" default="hugmy2" />
  <!-- Keep the arm joints in the kinematic model so model_update.launch can switch /joint_states from the straight pose to the estimated bent pose. Fixed-arm-only simulations override this explicitly. -->
  <arg name="fixed_arms" default="false" />
  <!-- The normal Hugmy workflow drives the kinematic model from joint_model. Relaying Gazebo's physical joints to the same topic would create two competing /joint_states publishers and overwrite that commanded pose. -->
  <arg name="use_gazebo_joint_states" default="false" />
  <arg name="model_options" default="" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="1.0"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="robot_id" default="" />
  <arg name="flight_controller_port" default="/dev/flight_controller" />
  <arg name="start_spinal_bridge" default="true" />
  <arg name="start_mocap" default="true" />
  <arg name="track_hand_mocap" default="false" />
  <arg name="mocap_robot_rigid_body_id" default="1" />
  <arg name="mocap_hand_rigid_body_id" default="2" />
  <arg name="robot_ns" value="quadrotor$(arg robot_id)" />
  <arg name="config_dir" default="$(find hugmy)/config" />
  <arg name="mujoco_model" default="$(find hugmy)/mujoco/hugmy2/robot.xml" />
  <!-- Optional precharged fixture setup, simulation only; empty keeps YAML. -->
  <arg name="mujoco_initial_arm_pressure" default="" />
  <arg name="mujoco_initial_bottom_pressure" default="" />
  <!-- Optional contact-fixture overrides; empty leaves the baseline unchanged. -->
  <arg name="mujoco_cylinder_radius" default="" />
  <arg name="mujoco_forearm_half_length" default="" />
  <arg name="mujoco_forearm_proximal_width" default="" />
  <arg name="mujoco_forearm_proximal_depth" default="" />
  <arg name="mujoco_forearm_distal_width" default="" />
  <arg name="mujoco_forearm_distal_depth" default="" />
  <arg name="mujoco_cylinder_pitch" default="" />
  <arg name="mujoco_grip_friction" default="" />
  <arg name="mujoco_surface_friction" default="" />
  <arg name="mujoco_tangential_stiffness" default="" />
  <arg name="gym_step_mode" default="false" />
  <arg name="gym_step_duration" default="0.1" />
  <arg name="gym_physics_timestep" default="0.0" />

  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">

    ###########  Basic Param  ###########
    # EGOMOTION_ESTIMATE = 0
    # EXPERIMENT_ESTIMATE = 1. for unstable mocap, use this mode
    # GROUND_TRUTH = 2
    <param name="estimation/mode" value= "$(arg sim_estimate_mode)" if="$(arg simulation)" />
    <param name="estimation/mode" value= "$(arg estimate_mode)" if="$(arg real_machine)"/>

    <param name="uav_model" value= "0" />
    <rosparam file="$(arg config_dir)/RobotModel.yaml" command="load" />

    ###########  Motor Config  ###########
    <rosparam file="$(arg config_dir)/MotorInfo_3D_V.yaml" command="load" />

    ###########  Battery Config  ###########
    <rosparam file="$(arg config_dir)/Battery.yaml" command="load" />

    ###########  Control  ###########
    <rosparam file="$(arg config_dir)/FlightControl.yaml" command="load" />
    <rosparam file="$(arg config_dir)/QuadBiControl.yaml" command="load"
              if="$(arg quad_bi_controller)" />

    ###########  Servo Config  ###########
    <rosparam file="$(arg config_dir)/Servo.yaml" command="load" />

    ###########  Sensor Fusion  ###########
    <rosparam file="$(arg config_dir)/StateEstimation.yaml" command="load" />
    <rosparam file="$(arg config_dir)/Simulation.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>
    <rosparam file="$(arg config_dir)/MujocoPneumatic.yaml" command="load"
              if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco') and arg('enable_pneumatic_plugin') and not arg('fixed_arms'))"/>
    <param name="simulation/pneumatic/spawn_human" value="$(arg spawn_human)"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))"/>
    <param name="simulation/pneumatic/initial_pressure" value="$(arg mujoco_initial_arm_pressure)" type="double"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco') and arg('mujoco_initial_arm_pressure') != '')"/>
    <param name="simulation/pneumatic/initial_bottom_pressure" value="$(arg mujoco_initial_bottom_pressure)" type="double"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco') and arg('mujoco_initial_bottom_pressure') != '')"/>
    <group if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))">
      <param name="simulation/pneumatic/human_arm_radius" value="$(arg mujoco_cylinder_radius)" type="double"
             if="$(eval arg('mujoco_cylinder_radius') != '')"/>
      <param name="simulation/pneumatic/human_arm_half_length" value="$(arg mujoco_forearm_half_length)" type="double"
             if="$(eval arg('mujoco_forearm_half_length') != '')"/>
      <param name="simulation/pneumatic/human_arm_proximal_width" value="$(arg mujoco_forearm_proximal_width)" type="double"
             if="$(eval arg('mujoco_forearm_proximal_width') != '')"/>
      <param name="simulation/pneumatic/human_arm_proximal_depth" value="$(arg mujoco_forearm_proximal_depth)" type="double"
             if="$(eval arg('mujoco_forearm_proximal_depth') != '')"/>
      <param name="simulation/pneumatic/human_arm_distal_width" value="$(arg mujoco_forearm_distal_width)" type="double"
             if="$(eval arg('mujoco_forearm_distal_width') != '')"/>
      <param name="simulation/pneumatic/human_arm_distal_depth" value="$(arg mujoco_forearm_distal_depth)" type="double"
             if="$(eval arg('mujoco_forearm_distal_depth') != '')"/>
      <param name="simulation/pneumatic/human_arm_pitch" value="$(arg mujoco_cylinder_pitch)" type="double"
             if="$(eval arg('mujoco_cylinder_pitch') != '')"/>
      <param name="simulation/pneumatic/grip_friction_coefficient" value="$(arg mujoco_grip_friction)" type="double"
             if="$(eval arg('mujoco_grip_friction') != '')"/>
      <param name="simulation/pneumatic/human_arm_sliding_friction" value="$(arg mujoco_surface_friction)" type="double"
             if="$(eval arg('mujoco_surface_friction') != '')"/>
      <param name="simulation/pneumatic/grip_tangential_stiffness" value="$(arg mujoco_tangential_stiffness)" type="double"
             if="$(eval arg('mujoco_tangential_stiffness') != '')"/>
    </group>
    <param name="simulation/pneumatic/human_arm_center_z" value="$(arg human_arm_center_z)"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))"/>
    <param name="simulation/pneumatic/initial_height_offset"
           value="$(arg mujoco_initial_height_offset)"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))"/>
    <param name="simulation/pneumatic/gym_step_mode" value="$(arg gym_step_mode)"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))"/>
    <param name="simulation/pneumatic/gym_step_duration" value="$(arg gym_step_duration)"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))"/>
    <param name="simulation/pneumatic/gym_physics_timestep"
           value="$(arg gym_physics_timestep)"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))"/>

    ###########  Navigation  ###########
    <param name="flight_navigation_plugin_name" value="aerial_robot_navigation/hugmy_navigation" />
    <rosparam file="$(arg config_dir)/NavigationConfig.yaml" command="load" />
  </group>

  ###########  Base Platform  ###########
  <node pkg="aerial_robot_base" type="aerial_robot_base_node" name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen"> <!-- launch-prefix="gdb -ex run -\-args"> -->
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="40"/>
  </node>

  ###########  Robot Model  ###########
  <arg name="description_mode" value="urdf" unless="$(arg simulation)" />
  <arg name="description_mode" value="gazebo" if="$(arg simulation)" />
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="robot_model" value="$(find hugmy)/urdf/$(arg robot_model_name).$(arg description_mode).xacro" unless="$(arg direct_model)"/>
    <arg name="robot_model" value="$(arg direct_model_name)" if="$(arg direct_model)"/>
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="model_options" value="fixed_arms:=$(arg fixed_arms) enable_pneumatic_plugin:=$(arg enable_pneumatic_plugin) $(arg model_options)" />
    <arg name="rviz_config" value="$(arg config_dir)/rviz_config.rviz" />
    <arg name="rviz_init_pose" value="$(arg config_dir)/RvizInit.yaml" />
    <arg name="need_joint_state" value="false" if ="$(eval arg('simulation') or arg('real_machine'))"/>
  </include>

  ###########  Sensors ###########
  <include file="$(find hugmy)/launch/includes/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="flight_controller_port" value="$(arg flight_controller_port)" />
    <arg name="start_spinal_bridge" value="$(arg start_spinal_bridge)" />
    <arg name="start_mocap" value="$(arg start_mocap)" />
    <arg name="track_hand_mocap" value="$(arg track_hand_mocap)" />
    <arg name="mocap_robot_rigid_body_id" value="$(arg mocap_robot_rigid_body_id)" />
    <arg name="mocap_hand_rigid_body_id" value="$(arg mocap_hand_rigid_body_id)" />
  </include >
  <!-- sensors.launch.xml loads the generic mocap defaults after Simulation.yaml.
       Restore the simulation startup grace so delayed first ground-truth data
       cannot latch a false force-landing state while MuJoCo is starting. -->
  <param name="$(arg robot_ns)/sensor_plugin/mocap/health_timeout" value="2.0"
         if="$(eval arg('simulation') and not arg('real_machine'))" />

  ###########  Servo Bridge  ###########
  <!-- <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge"  output="screen" ns="$(arg robot_ns)"> -->
  <!--   <param name="use_mujoco" value="true" if="$(arg mujoco)"/> -->
  <!-- </node> -->

  ########## Simulation in Gazebo #########
  <include file="$(find aerial_robot_simulation)/launch/gazebo.launch" if = "$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco'))" >
    <arg name="robot_ns" default="$(arg robot_ns)" />
    <arg name="gui" default="false" if="$(arg headless)" />
    <arg name="headless" default="$(arg headless)" />
    <arg name="launch_gazebo" default="$(arg launch_gazebo)" />
    <arg name="worldtype" value="$(arg worldtype)" />
    <arg name="spawn_x" value="$(arg spawn_x)" />
    <arg name="spawn_y" value="$(arg spawn_y)" />
    <arg name="spawn_z" value="$(arg spawn_z)" />
    <arg name="spawn_yaw" value="$(arg spawn_yaw)" />
  </include>

  ########## Simulation in MuJoCo #########
  <include file="$(find aerial_robot_simulation)/launch/mujoco.launch"
           if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))">
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="mujoco_model" value="$(arg mujoco_model)" />
    <arg name="hw_sim_type"
         value="$(eval 'hugmy/HugmyPneumaticHWSim' if arg('enable_pneumatic_plugin') and not arg('fixed_arms') else 'mujoco_ros_control/AerialRobotHWSim')" />
  </include>

  <!-- Optional physical-joint mode.  Leave this disabled when joint_model is publishing the commanded/estimated kinematic pose on joint_states. -->
  <node name="gazebo_joint_state_relay" pkg="topic_tools" type="relay" ns="$(arg robot_ns)" output="screen" args="joint_states_gazebo joint_states" if="$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco') and arg('use_gazebo_joint_states'))"/>

  ########## Hugmy pneumatic controllers #########
  <include file="$(find hugmy)/launch/independent_arm_pressure_controller.launch"
           if="$(eval (arg('start_pressure_controller') or arg('quad_bi_controller')) and not arg('start_attitude_allocator'))">
    <arg name="robot_ns" value="$(arg robot_ns)"/>
  </include>

  <!-- attitude_pressure_controller.launch also starts the pressure controller. -->
  <include file="$(find hugmy)/launch/attitude_pressure_controller.launch"
           if="$(eval arg('simulation') and arg('start_attitude_allocator'))">
    <arg name="robot_ns" value="$(arg robot_ns)"/>
    <arg name="inchworm_action_c" value="$(arg inchworm_action_c)"/>
    <arg name="hybrid_locomotion_outer_enabled" value="$(arg hybrid_locomotion_outer_enabled)"/>
    <arg name="hybrid_locomotion_initial_bottom_kpa" value="$(arg hybrid_locomotion_initial_bottom_kpa)"/>
    <arg name="hybrid_rear_release_sec" value="$(arg hybrid_rear_release_sec)"/>
    <arg name="hybrid_rear_grasp_sec" value="$(arg hybrid_rear_grasp_sec)"/>
    <arg name="hybrid_rear_low_kpa" value="$(arg hybrid_rear_low_kpa)"/>
    <arg name="hybrid_rear_vent_lead_margin_sec" value="$(arg hybrid_rear_vent_lead_margin_sec)"/>
    <arg name="hybrid_rear_vent_start_margin_rad" value="$(arg hybrid_rear_vent_start_margin_rad)"/>
    <arg name="hybrid_locomotion_initial_m" value="$(arg hybrid_locomotion_initial_m)"/>
    <arg name="hybrid_locomotion_retain_grasp_pressure" value="$(arg hybrid_locomotion_retain_grasp_pressure)"/>
    <arg name="hybrid_locomotion_regrip_timeout_sec" value="$(arg hybrid_locomotion_regrip_timeout_sec)"/>
    <arg name="hybrid_lift_pressure_gain_kpa_s_rad" value="$(arg hybrid_lift_pressure_gain_kpa_s_rad)"/>
    <arg name="hybrid_slip_min_progress_m" value="$(arg hybrid_slip_min_progress_m)"/>
    <arg name="hybrid_slip_min_speed_m_s" value="$(arg hybrid_slip_min_speed_m_s)"/>
    <arg name="hybrid_lift_probe_sec" value="$(arg hybrid_lift_probe_sec)"/>
    <arg name="hybrid_lift_search_rate_n_s" value="$(arg hybrid_lift_search_rate_n_s)"/>
    <arg name="hybrid_reused_lift_rise_n_s" value="$(arg hybrid_reused_lift_rise_n_s)"/>
    <arg name="hybrid_trajectory_min_extension_rad" value="$(arg hybrid_trajectory_min_extension_rad)"/>
    <arg name="hybrid_trajectory_extension_rate_rad_s" value="$(arg hybrid_trajectory_extension_rate_rad_s)"/>
    <arg name="hybrid_lift_rear_release_start_ratio" value="$(arg hybrid_lift_rear_release_start_ratio)"/>
    <arg name="hybrid_lift_rear_pressure_floor_kpa" value="$(arg hybrid_lift_rear_pressure_floor_kpa)"/>
    <arg name="hybrid_regrip_rear_hold_pressure_kpa" value="$(arg hybrid_regrip_rear_hold_pressure_kpa)"/>
    <arg name="hybrid_pull_rear_release_start_ratio" value="$(arg hybrid_pull_rear_release_start_ratio)"/>
    <arg name="hybrid_pull_rear_release_end_ratio" value="$(arg hybrid_pull_rear_release_end_ratio)"/>
    <arg name="hybrid_trajectory_golden_handoff_enabled" value="$(arg hybrid_trajectory_golden_handoff_enabled)"/>
    <arg name="hybrid_trajectory_windup_pitch_rad" value="$(arg hybrid_trajectory_windup_pitch_rad)"/>
    <arg name="hybrid_trajectory_windup_pitch_kp_n_rad" value="$(arg hybrid_trajectory_windup_pitch_kp_n_rad)"/>
    <arg name="hybrid_trajectory_windup_pitch_kd_n_s_rad" value="$(arg hybrid_trajectory_windup_pitch_kd_n_s_rad)"/>
    <arg name="hybrid_trajectory_windup_pitch_rate_max_rad_s" value="$(arg hybrid_trajectory_windup_pitch_rate_max_rad_s)"/>
    <arg name="hybrid_trajectory_windup_bottom_kpa" value="$(arg hybrid_trajectory_windup_bottom_kpa)"/>
    <arg name="hybrid_trajectory_windup_extra_extension_rad" value="$(arg hybrid_trajectory_windup_extra_extension_rad)"/>
    <arg name="hybrid_trajectory_windup_hold_pressure_kpa" value="$(arg hybrid_trajectory_windup_hold_pressure_kpa)"/>
    <arg name="hybrid_trajectory_windup_pressure_slew_kpa_s" value="$(arg hybrid_trajectory_windup_pressure_slew_kpa_s)"/>
    <arg name="hybrid_trajectory_windup_rear_reverse_max_n" value="$(arg hybrid_trajectory_windup_rear_reverse_max_n)"/>
    <arg name="hybrid_trajectory_windup_rear_reverse_rise_n_s" value="$(arg hybrid_trajectory_windup_rear_reverse_rise_n_s)"/>
    <arg name="hybrid_locomotion_pitch_change_limit_rad" value="$(arg hybrid_locomotion_pitch_change_limit_rad)"/>
    <arg name="hybrid_trajectory_flex_rate_rad_s" value="$(arg hybrid_trajectory_flex_rate_rad_s)"/>
    <arg name="hybrid_trajectory_pressure_lead_max_sec" value="$(arg hybrid_trajectory_pressure_lead_max_sec)"/>
    <arg name="hybrid_reused_lift_brake_margin_rad" value="$(arg hybrid_reused_lift_brake_margin_rad)"/>
    <arg name="hybrid_pull_min_sec" value="$(arg hybrid_pull_min_sec)"/>
    <arg name="hybrid_probe_extension_rad" value="$(arg hybrid_probe_extension_rad)"/>
    <arg name="hybrid_lift_identification_bend_rad" value="$(arg hybrid_lift_identification_bend_rad)"/>
    <arg name="hybrid_lift_identification_tolerance_rad" value="$(arg hybrid_lift_identification_tolerance_rad)"/>
    <arg name="hybrid_lift_identification_extension_limit_rad" value="$(arg hybrid_lift_identification_extension_limit_rad)"/>
    <arg name="hybrid_lift_identification_rate_feedback_min_bend_rad" value="$(arg hybrid_lift_identification_rate_feedback_min_bend_rad)"/>
    <arg name="hybrid_lift_identification_rate_filter_tau_sec" value="$(arg hybrid_lift_identification_rate_filter_tau_sec)"/>
    <arg name="hybrid_lift_identification_rate_confirm_sec" value="$(arg hybrid_lift_identification_rate_confirm_sec)"/>
    <arg name="hybrid_lift_unload_min_extension_rad" value="$(arg hybrid_lift_unload_min_extension_rad)"/>
    <arg name="hybrid_lift_unload_pitch_rad" value="$(arg hybrid_lift_unload_pitch_rad)"/>
    <arg name="hybrid_lift_unload_height_m" value="$(arg hybrid_lift_unload_height_m)"/>
    <arg name="hybrid_directional_pitch_sign" value="$(arg hybrid_directional_pitch_sign)"/>
    <arg name="hybrid_lift_unload_confirm_sec" value="$(arg hybrid_lift_unload_confirm_sec)"/>
    <arg name="hybrid_lift_unload_prefill_start_ratio" value="$(arg hybrid_lift_unload_prefill_start_ratio)"/>
    <arg name="hybrid_lift_unload_prefill_kpa" value="$(arg hybrid_lift_unload_prefill_kpa)"/>
    <arg name="hybrid_lift_unload_prefill_max_prediction_sec" value="$(arg hybrid_lift_unload_prefill_max_prediction_sec)"/>
    <arg name="hybrid_lift_unload_prefill_max_prediction_lead_ratio" value="$(arg hybrid_lift_unload_prefill_max_prediction_lead_ratio)"/>
    <arg name="hybrid_slip_probe_max_thrust_n" value="$(arg hybrid_slip_probe_max_thrust_n)"/>
    <arg name="hybrid_slip_probe_max_pressure_kpa" value="$(arg hybrid_slip_probe_max_pressure_kpa)"/>
    <arg name="maximum_pressure_kpa" value="$(arg maximum_pressure_kpa)"/>
    <!-- Pass one explicit convention to both the gait's inner roll feedback
         and shared posture recovery. -->
    <arg name="correction_pair_reverse_spinal_mapping"
         value="$(arg correction_pair_reverse_spinal_mapping)"/>
    <arg name="hybrid_reverse_geometry_roll_moment"
         value="$(arg hybrid_reverse_geometry_roll_moment)"/>
    <arg name="recovery_predictive_enabled" value="$(arg recovery_predictive_enabled)"/>
    <arg name="recovery_predictive_shadow" value="$(arg recovery_predictive_shadow)"/>
    <arg name="inchworm_action_d" value="$(arg inchworm_action_d)"/>
  </include>

</launch>
