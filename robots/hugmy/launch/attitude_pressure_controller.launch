<launch>
  <arg name="robot_ns" default="quadrotor" />
  <arg name="inchworm_action_b" default="false" />
  <arg name="inchworm_action_c" default="false" />
  <arg name="hybrid_locomotion_outer_enabled" default="true" />
  <arg name="hybrid_locomotion_initial_bottom_kpa" default="30.0" />
  <arg name="hybrid_rear_release_sec" default="2.0" />
  <arg name="hybrid_rear_grasp_sec" default="1.0" />
  <arg name="hybrid_rear_low_kpa" default="0.0" />
  <arg name="hybrid_rear_vent_lead_margin_sec" default="0.10" />
  <arg name="hybrid_rear_vent_start_margin_rad" default="0.08726646259971647" />
  <arg name="hybrid_locomotion_initial_m" default="1.0" />
  <arg name="hybrid_locomotion_retain_grasp_pressure" default="false" />
  <arg name="hybrid_locomotion_regrip_timeout_sec" default="20.0" />
  <arg name="hybrid_lift_pressure_gain_kpa_s_rad" default="20.0" />
  <arg name="hybrid_lift_probe_sec" default="10.0" />
  <arg name="hybrid_lift_search_rate_n_s" default="0.7" />
  <arg name="hybrid_reused_lift_rise_n_s" default="8.0" />
  <arg name="hybrid_reused_lift_brake_margin_rad" default="0.06981317007977318" />
  <arg name="hybrid_pull_min_sec" default="0.5" />
  <arg name="hybrid_probe_extension_rad" default="0.13962634015954636" />
  <arg name="hybrid_lift_identification_bend_rad" default="0.3490658503988659" />
  <arg name="hybrid_lift_identification_tolerance_rad" default="0.017453292519943295" />
  <arg name="hybrid_lift_identification_extension_limit_rad" default="1.3962634015954636" />
  <arg name="hybrid_slip_probe_max_pressure_kpa" default="40.0" />
  <arg name="maximum_pressure_kpa" default="40.0" />
  <arg name="correction_pair_reverse_spinal_mapping" default="false" />
  <arg name="inchworm_action_d" default="false" />
  <arg name="rocking_gait" default="false" />
  <arg name="recovery_predictive_enabled" default="true" />
  <arg name="recovery_predictive_shadow" default="true" />
  <arg name="bottom_control_enabled" default="true" />
  <arg name="use_mocap_attitude_for_inchworm" default="false" />
  <!-- Action-A gait parameters.  Defaults reproduce the YAML configuration;
       the optimization wrapper overrides them for each MuJoCo episode. -->
  <arg name="base_pressure_kpa" default="30.0" />
  <arg name="inchworm_front_release_kpa" default="5.0" />
  <arg name="inchworm_swing_pressure_kpa" default="0.0" />
  <arg name="inchworm_transfer_pressure_kpa" default="20.0" />
  <arg name="inchworm_rear_unload_kpa" default="8.0" />
  <arg name="inchworm_pull_pressure_kpa" default="5.0" />
  <arg name="inchworm_front_pull_pressure_kpa" default="30.0" />
  <arg name="inchworm_reach_thrust_n" default="2.0" />
  <arg name="inchworm_reach_max_thrust_n" default="6.0" />
  <arg name="inchworm_rear_lift_thrust_n" default="3.0" />
  <arg name="inchworm_rear_reverse_thrust_n" default="0.0" />
  <arg name="inchworm_release_timeout_sec" default="30.0" />
  <arg name="inchworm_reach_duration_sec" default="10.0" />
  <arg name="action_a_place_bend_target_rad" default="1.5707963" />
  <arg name="action_a_place_hold_sec" default="0.0" />
  <arg name="action_a_place_thrust_down_rate_n_s" default="1.5" />
  <arg name="action_a_rear_thrust_down_rate_n_s" default="2.0" />
  <arg name="action_a_place_timeout_sec" default="15.0" />
  <arg name="action_a_tilt_soft_limit_rad" default="0.0872665" />
  <arg name="action_a_tilt_hard_limit_rad" default="0.2094395" />
  <arg name="action_a_tilt_prediction_horizon_sec" default="0.15" />
  <arg name="action_a_tilt_thrust_down_rate_n_s" default="3.0" />
  <arg name="action_a_tilt_limited_bend_target_rad" default="0.7853982" />
  <arg name="action_a_diagonal_assist_enabled" default="true" />
  <arg name="action_a_diagonal_assist_thrust_n" default="2.0" />
  <arg name="action_a_diagonal_assist_thrust_ramp_n_s" default="0.3" />
  <arg name="action_a_diagonal_assist_thrust_down_rate_n_s" default="1.5" />
  <arg name="action_a_arm0_rebend_pressure_kpa" default="40.0" />
  <arg name="action_a_bottom_enabled" default="true" />
  <arg name="action_a_bottom_low_kpa" default="0.0" />
  <arg name="action_a_bottom_high_kpa" default="30.0" />
  <arg name="action_d_tilt_soft_limit_rad" default="0.2094395" />
  <arg name="action_d_tilt_resume_rad" default="0.1396263" />
  <arg name="action_d_max_tilt_rad" default="0.3490659" />
  <arg name="action_d_max_body_rate_rad_s" default="0.8" />
  <arg name="action_d_posture_thrust_down_rate_n_s" default="1.0" />
  <arg name="action_d_front_thrust_ramp_n_s" default="2.0" />
  <arg name="action_d_rear_thrust_ramp_n_s" default="1.0" />
  <arg name="action_d_thrust_step_n" default="1.0" />
  <arg name="action_d_pulse_on_sec" default="0.6" />
  <arg name="action_d_pulse_off_sec" default="1.0" />
  <arg name="action_d_thrust_down_rate_n_s" default="20.0" />
  <arg name="action_d_max_front_thrust_n" default="6.0" />
  <arg name="action_d_max_rear_thrust_n" default="1.5" />
  <arg name="action_d_rear_pressure_drop_per_thrust_kpa_n" default="0.0" />
  <arg name="inchworm_target_straightening_angle_rad" default="-1.0" />
  <arg name="inchworm_stroke_distance_m" default="0.002" />
  <arg name="inchworm_max_cycles" default="10" />
  <arg name="rocking_bottom_low_kpa" default="0.0" />
  <arg name="rocking_bottom_high_kpa" default="50.0" />
  <arg name="rocking_front_release_kpa" default="0.0" />
  <arg name="rocking_rear_release_kpa" default="0.0" />
  <arg name="rocking_front_windup_pressure_kpa" default="30.0" />
  <arg name="rocking_front_extend_thrust_n" default="6.0" />
  <arg name="rocking_front_windup_target_rad" default="2.0943951" />
  <arg name="rocking_front_extend_target_rad" default="0.3490659" />
  <arg name="rocking_front_place_bend_target_rad" default="1.5707963" />
  <arg name="rocking_front_place_pressure_kpa" default="40.0" />
  <arg name="rocking_front_min_advance_m" default="0.003" />
  <arg name="rocking_rear_reverse_thrust_n" default="0.8" />
  <arg name="rocking_front_tilt_target_rad"
       default="$(eval 0.90 * float(arg('rocking_bottom_high_kpa')) * 0.2617994 / 50.0)" />
  <arg name="rocking_recovery_tilt_target_rad" default="0.00872665" />
  <arg name="rocking_phase_timeout_sec" default="10.0" />
  <arg name="rocking_thrust_ramp_n_s" default="6.0" />
  <arg name="rocking_front_windup_hold_sec" default="0.20" />
  <arg name="rocking_front_extend_hold_sec" default="0.05" />
  <arg name="rocking_front_lower_rate_n_s" default="1.5" />
  <arg name="rocking_land_settle_sec" default="0.4" />
  <arg name="rocking_max_tilt_rad" default="0.5235988" />

  <group ns="$(arg robot_ns)">
    <node pkg="hugmy"
          type="independent_arm_pressure_controller_node"
          name="independent_arm_pressure_controller"
          output="screen">
      <rosparam command="load"
                file="$(find hugmy)/config/independent_arm_pressure_controller.yaml" />
      <param name="bottom_control_enabled" value="$(arg bottom_control_enabled)" />
    </node>

    <node pkg="hugmy"
          type="attitude_pressure_controller_node"
          name="attitude_pressure_controller"
          output="screen">
      <rosparam command="load"
                file="$(find hugmy)/config/attitude_pressure_controller.yaml" />
      <param name="recovery_predictive_enabled" value="$(arg recovery_predictive_enabled)" />
      <param name="recovery_predictive_shadow" value="$(arg recovery_predictive_shadow)" />
      <param name="inchworm_action_b_enabled" value="$(arg inchworm_action_b)" />
      <param name="inchworm_action_c_enabled" value="$(arg inchworm_action_c)" />
      <param name="hybrid_locomotion_outer_enabled" value="$(arg hybrid_locomotion_outer_enabled)" />
      <param name="hybrid_locomotion_initial_bottom_kpa" value="$(arg hybrid_locomotion_initial_bottom_kpa)" />
      <param name="hybrid_rear_release_sec" value="$(arg hybrid_rear_release_sec)" />
      <param name="hybrid_rear_grasp_sec" value="$(arg hybrid_rear_grasp_sec)" />
      <param name="hybrid_rear_low_kpa" value="$(arg hybrid_rear_low_kpa)" />
      <param name="hybrid_rear_vent_lead_margin_sec" value="$(arg hybrid_rear_vent_lead_margin_sec)" />
      <param name="hybrid_rear_vent_start_margin_rad" value="$(arg hybrid_rear_vent_start_margin_rad)" />
      <param name="hybrid_locomotion_initial_m" value="$(arg hybrid_locomotion_initial_m)" />
      <param name="hybrid_locomotion_retain_grasp_pressure" value="$(arg hybrid_locomotion_retain_grasp_pressure)" />
      <param name="hybrid_locomotion_regrip_timeout_sec" value="$(arg hybrid_locomotion_regrip_timeout_sec)" />
      <param name="hybrid_lift_pressure_gain_kpa_s_rad" value="$(arg hybrid_lift_pressure_gain_kpa_s_rad)" />
      <param name="hybrid_lift_probe_sec" value="$(arg hybrid_lift_probe_sec)" />
      <param name="hybrid_lift_search_rate_n_s" value="$(arg hybrid_lift_search_rate_n_s)" />
      <param name="hybrid_reused_lift_rise_n_s" value="$(arg hybrid_reused_lift_rise_n_s)" />
      <param name="hybrid_reused_lift_brake_margin_rad" value="$(arg hybrid_reused_lift_brake_margin_rad)" />
      <param name="hybrid_pull_min_sec" value="$(arg hybrid_pull_min_sec)" />
      <param name="hybrid_probe_extension_rad" value="$(arg hybrid_probe_extension_rad)" />
      <param name="hybrid_lift_identification_bend_rad" value="$(arg hybrid_lift_identification_bend_rad)" />
      <param name="hybrid_lift_identification_tolerance_rad" value="$(arg hybrid_lift_identification_tolerance_rad)" />
      <param name="hybrid_lift_identification_extension_limit_rad" value="$(arg hybrid_lift_identification_extension_limit_rad)" />
      <param name="hybrid_slip_probe_max_pressure_kpa" value="$(arg hybrid_slip_probe_max_pressure_kpa)" />
      <param name="maximum_pressure_kpa" value="$(arg maximum_pressure_kpa)" />
      <param name="correction_pair_reverse_spinal_mapping" value="$(arg correction_pair_reverse_spinal_mapping)" />
      <param name="inchworm_action_d_enabled" value="$(arg inchworm_action_d)" />
      <param name="rocking_gait_enabled" value="$(arg rocking_gait)" />
      <param name="base_pressure_kpa" value="$(arg base_pressure_kpa)" />
      <param name="inchworm_front_release_kpa" value="$(arg inchworm_front_release_kpa)" />
      <param name="inchworm_swing_pressure_kpa" value="$(arg inchworm_swing_pressure_kpa)" />
      <param name="inchworm_transfer_pressure_kpa" value="$(arg inchworm_transfer_pressure_kpa)" />
      <param name="inchworm_rear_unload_kpa" value="$(arg inchworm_rear_unload_kpa)" />
      <param name="inchworm_pull_pressure_kpa" value="$(arg inchworm_pull_pressure_kpa)" />
      <param name="inchworm_front_pull_pressure_kpa"
             value="$(arg inchworm_front_pull_pressure_kpa)" />
      <param name="inchworm_reach_thrust_n" value="$(arg inchworm_reach_thrust_n)" />
      <param name="inchworm_reach_max_thrust_n"
             value="$(arg inchworm_reach_max_thrust_n)" />
      <param name="inchworm_rear_lift_thrust_n" value="$(arg inchworm_rear_lift_thrust_n)" />
      <param name="inchworm_rear_reverse_thrust_n"
             value="$(arg inchworm_rear_reverse_thrust_n)" />
      <param name="inchworm_release_timeout_sec"
             value="$(arg inchworm_release_timeout_sec)" />
      <param name="inchworm_reach_duration_sec" value="$(arg inchworm_reach_duration_sec)" />
      <param name="action_a_place_bend_target_rad"
             value="$(arg action_a_place_bend_target_rad)" />
      <param name="action_a_place_hold_sec" value="$(arg action_a_place_hold_sec)" />
      <param name="action_a_place_thrust_down_rate_n_s"
             value="$(arg action_a_place_thrust_down_rate_n_s)" />
      <param name="action_a_rear_thrust_down_rate_n_s"
             value="$(arg action_a_rear_thrust_down_rate_n_s)" />
      <param name="action_a_place_timeout_sec"
             value="$(arg action_a_place_timeout_sec)" />
      <param name="action_a_tilt_soft_limit_rad"
             value="$(arg action_a_tilt_soft_limit_rad)" />
      <param name="action_a_tilt_hard_limit_rad"
             value="$(arg action_a_tilt_hard_limit_rad)" />
      <param name="action_a_tilt_prediction_horizon_sec"
             value="$(arg action_a_tilt_prediction_horizon_sec)" />
      <param name="action_a_tilt_thrust_down_rate_n_s"
             value="$(arg action_a_tilt_thrust_down_rate_n_s)" />
      <param name="action_a_tilt_limited_bend_target_rad"
             value="$(arg action_a_tilt_limited_bend_target_rad)" />
      <param name="action_a_diagonal_assist_enabled"
             value="$(arg action_a_diagonal_assist_enabled)" />
      <param name="action_a_diagonal_assist_thrust_n"
             value="$(arg action_a_diagonal_assist_thrust_n)" />
      <param name="action_a_diagonal_assist_thrust_ramp_n_s"
             value="$(arg action_a_diagonal_assist_thrust_ramp_n_s)" />
      <param name="action_a_diagonal_assist_thrust_down_rate_n_s"
             value="$(arg action_a_diagonal_assist_thrust_down_rate_n_s)" />
      <param name="action_a_arm0_rebend_pressure_kpa"
             value="$(arg action_a_arm0_rebend_pressure_kpa)" />
      <param name="action_a_bottom_enabled" value="$(arg action_a_bottom_enabled)" />
      <param name="action_a_bottom_low_kpa" value="$(arg action_a_bottom_low_kpa)" />
      <param name="action_a_bottom_high_kpa" value="$(arg action_a_bottom_high_kpa)" />
      <param name="action_d_tilt_soft_limit_rad"
             value="$(arg action_d_tilt_soft_limit_rad)" />
      <param name="action_d_tilt_resume_rad"
             value="$(arg action_d_tilt_resume_rad)" />
      <param name="action_d_max_tilt_rad"
             value="$(arg action_d_max_tilt_rad)" />
      <param name="action_d_max_body_rate_rad_s"
             value="$(arg action_d_max_body_rate_rad_s)" />
      <param name="action_d_posture_thrust_down_rate_n_s"
             value="$(arg action_d_posture_thrust_down_rate_n_s)" />
      <param name="action_d_front_thrust_ramp_n_s"
             value="$(arg action_d_front_thrust_ramp_n_s)" />
      <param name="action_d_rear_thrust_ramp_n_s"
             value="$(arg action_d_rear_thrust_ramp_n_s)" />
      <param name="action_d_thrust_step_n"
             value="$(arg action_d_thrust_step_n)" />
      <param name="action_d_pulse_on_sec"
             value="$(arg action_d_pulse_on_sec)" />
      <param name="action_d_pulse_off_sec"
             value="$(arg action_d_pulse_off_sec)" />
      <param name="action_d_thrust_down_rate_n_s"
             value="$(arg action_d_thrust_down_rate_n_s)" />
      <param name="action_d_max_front_thrust_n"
             value="$(arg action_d_max_front_thrust_n)" />
      <param name="action_d_max_rear_thrust_n"
             value="$(arg action_d_max_rear_thrust_n)" />
      <param name="action_d_rear_pressure_drop_per_thrust_kpa_n"
             value="$(arg action_d_rear_pressure_drop_per_thrust_kpa_n)" />
      <param name="inchworm_target_straightening_angle_rad"
             value="$(arg inchworm_target_straightening_angle_rad)" />
      <param name="inchworm_stroke_distance_m" value="$(arg inchworm_stroke_distance_m)" />
      <param name="inchworm_max_cycles" value="$(arg inchworm_max_cycles)" />
      <param name="rocking_bottom_low_kpa" value="$(arg rocking_bottom_low_kpa)" />
      <param name="rocking_bottom_high_kpa" value="$(arg rocking_bottom_high_kpa)" />
      <param name="rocking_front_release_kpa" value="$(arg rocking_front_release_kpa)" />
      <param name="rocking_rear_release_kpa" value="$(arg rocking_rear_release_kpa)" />
      <param name="rocking_front_windup_pressure_kpa"
             value="$(arg rocking_front_windup_pressure_kpa)" />
      <param name="rocking_front_extend_thrust_n"
             value="$(arg rocking_front_extend_thrust_n)" />
      <param name="rocking_front_windup_target_rad"
             value="$(arg rocking_front_windup_target_rad)" />
      <param name="rocking_front_extend_target_rad"
             value="$(arg rocking_front_extend_target_rad)" />
      <param name="rocking_front_place_bend_target_rad"
             value="$(arg rocking_front_place_bend_target_rad)" />
      <param name="rocking_front_place_pressure_kpa"
             value="$(arg rocking_front_place_pressure_kpa)" />
      <param name="rocking_front_min_advance_m"
             value="$(arg rocking_front_min_advance_m)" />
      <param name="rocking_rear_reverse_thrust_n" value="$(arg rocking_rear_reverse_thrust_n)" />
      <param name="rocking_front_tilt_target_rad" value="$(arg rocking_front_tilt_target_rad)" />
      <param name="rocking_recovery_tilt_target_rad" value="$(arg rocking_recovery_tilt_target_rad)" />
      <param name="rocking_phase_timeout_sec" value="$(arg rocking_phase_timeout_sec)" />
      <param name="rocking_thrust_ramp_n_s" value="$(arg rocking_thrust_ramp_n_s)" />
      <param name="rocking_front_windup_hold_sec"
             value="$(arg rocking_front_windup_hold_sec)" />
      <param name="rocking_front_extend_hold_sec"
             value="$(arg rocking_front_extend_hold_sec)" />
      <param name="rocking_front_lower_rate_n_s" value="$(arg rocking_front_lower_rate_n_s)" />
      <param name="rocking_land_settle_sec" value="$(arg rocking_land_settle_sec)" />
      <param name="rocking_max_tilt_rad" value="$(arg rocking_max_tilt_rad)" />
      <param name="use_mocap_attitude_for_inchworm"
             value="$(arg use_mocap_attitude_for_inchworm)" />
    </node>
  </group>
</launch>
